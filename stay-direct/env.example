# Copy these into your hosting dashboard (Vercel: Project > Settings > Environment Variables).
# For local use, save them in a file called .env in this folder. Never commit that file.

# --- Guesty (required) ---------------------------------------------------------
# From Guesty: your Booking Engine API instance. These are the OAuth client credentials.
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=

# --- Shared token store (required on Vercel) -----------------------------------
# Guesty allows only a few token renewals a day, so the token must be shared between server instances.
# Add the free "Upstash Redis" integration from the Vercel Marketplace. It sets KV_REST_API_URL and
# KV_REST_API_TOKEN for you. If you set up Upstash yourself, use these two instead:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Your site (all optional) --------------------------------------------------
SITE_NAME=Stay Direct
SITE_HEADLINE=Book direct and save
SITE_TAGLINE=Handpicked holiday homes, with the owner a message away.
SITE_PHONE=
SITE_EMAIL=
# Your public address, used for the sitemap and search engines. No trailing slash.
SITE_URL=
SITE_TIMEZONE=Australia/Sydney
SITE_LOCALE=en-AU
# Links shown in the footer and next to the booking checkbox.
SITE_TERMS_URL=
SITE_PRIVACY_URL=

# --- Developer settings --------------------------------------------------------
# Run with pretend properties and a pretend payment, no Guesty account needed. Never set this in production.
# GUESTY_MOCK=1
# Only change this if Guesty tells you to.
# GUESTY_BASE_URL=https://booking.guesty.com
